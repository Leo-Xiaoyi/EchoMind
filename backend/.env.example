# Copy to .env and fill in your own values. Never commit .env.
ANTHROPIC_API_KEY=replace-with-your-model-service-key
ANTHROPIC_MODEL=replace-with-a-supported-model-id
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

ECHOMIND_ENV=development
ECHOMIND_API_TOKENS=
REDIS_PASSWORD=replace-with-a-long-random-password
CHROMA_HOST=chromadb
CHROMA_PORT=8000
ECHOMIND_SEED_DEMO_DOCS=true
MCP_EXTERNAL_ENABLED=true
INTENT_EMBEDDING_PROVIDER=auto
SILICONFLOW_API_KEY=

# Optional host ports when the defaults are already in use.
# ECHOMIND_API_HOST_PORT=8000
# ECHOMIND_WEB_HOST_PORT=5174
# ECHOMIND_PROM_HOST_PORT=9090
